APP_ENV=development
# Docker Compose development: the password here MUST equal POSTGRES_PASSWORD below (the postgres container is initialised from it).
DATABASE_URL=postgresql+psycopg://healthguard:healthguard_dev_only@postgres:5432/healthguard
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=./private_storage
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=healthguard-private
STORAGE_ACCESS_KEY=healthguard
STORAGE_SECRET_KEY=replace-with-development-secret
STORAGE_REGION=us-east-1
STORAGE_SSE=AES256
HEALTHGUARD_JWT_SECRET=replace-with-a-long-random-secret
HEALTHGUARD_TOKEN_EXPIRY_HOURS=8
HEALTHGUARD_PBKDF2_ITERATIONS=600000
HEALTHGUARD_MAX_DOCUMENT_BYTES=20971520
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO

# Email (verification, follow-up reminders, operational alerts all use these same SMTP_* settings).
# Development default: the free Mailpit dev mailbox started by `docker compose up` (no domain, no account, nothing leaves your machine).
# Read the mail at http://127.0.0.1:8025 . Plain SMTP, so STARTTLS is off — this is rejected when APP_ENV=production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=healthguard@healthguard.localhost
SMTP_STARTTLS=false
# Production (any STARTTLS relay; Resend over SMTP shown): SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USERNAME=resend
# SMTP_PASSWORD=<Resend API key> SMTP_STARTTLS=true, SMTP_FROM on a domain verified with the provider. Port 465 is not supported.
HEALTHGUARD_PUBLIC_BASE_URL=http://localhost:8000
HEALTHGUARD_VERIFICATION_EXPIRY_HOURS=24
HEALTHGUARD_MAX_REQUEST_BODY_BYTES=23068672
HEALTHGUARD_RATE_LIMIT_PER_MINUTE=60
# Required in production for verification links; HTTPS public URL only.
# HEALTHGUARD_PUBLIC_BASE_URL=https://healthguard.example.com

# Sprint 2 Phase 2 — document classification / structured fact extraction
# Production must configure a real provider; API keys are server-side only.
HEALTHGUARD_LLM_PROVIDER=openai_compatible
HEALTHGUARD_LLM_BASE_URL=
HEALTHGUARD_LLM_MODEL=
HEALTHGUARD_LLM_API_KEY=

# Sprint 5 Phase 2 — AI safety / provider controls
HEALTHGUARD_AI_TIMEOUT_SECONDS=45
HEALTHGUARD_AI_MAX_RETRIES=1
# Production must use a real embedding provider; deterministic is test-only.
HEALTHGUARD_EMBEDDING_PROVIDER=deterministic
HEALTHGUARD_EMBEDDING_BASE_URL=
HEALTHGUARD_EMBEDDING_MODEL=
HEALTHGUARD_EMBEDDING_API_KEY=

# Phase 3 reliability
HEALTHGUARD_DB_CONNECT_TIMEOUT_SECONDS=10
HEALTHGUARD_DB_POOL_SIZE=10
HEALTHGUARD_DB_MAX_OVERFLOW=10
HEALTHGUARD_DB_POOL_TIMEOUT_SECONDS=30
HEALTHGUARD_DB_POOL_RECYCLE_SECONDS=1800
HEALTHGUARD_QUEUE_VISIBILITY_SECONDS=120
HEALTHGUARD_JOB_LEASE_SECONDS=120
HEALTHGUARD_JOB_MAX_ATTEMPTS=3
HEALTHGUARD_JOB_BACKOFF_SECONDS=5

# Phase 3 infrastructure reliability
HEALTHGUARD_REDIS_CONNECT_TIMEOUT_SECONDS=3
HEALTHGUARD_REDIS_SOCKET_TIMEOUT_SECONDS=5
HEALTHGUARD_REDIS_HEALTH_CHECK_SECONDS=30
HEALTHGUARD_S3_CONNECT_TIMEOUT_SECONDS=5
HEALTHGUARD_S3_READ_TIMEOUT_SECONDS=30
HEALTHGUARD_S3_MAX_ATTEMPTS=3

# Phase 4 production observability
# Required by scripts/production-start.sh and production-worker.sh even in development (an empty value stops the containers).
# Development placeholder only — production rejects any value containing "replace-with"; use >= 32 random characters.
HEALTHGUARD_METRICS_TOKEN=replace-with-a-development-metrics-token
# Set INFO/DEBUG as appropriate; production should normally use INFO.
HEALTHGUARD_LOG_LEVEL=INFO

# Production deployment / release
# Never commit a real production .env file.
POSTGRES_DB=healthguard
POSTGRES_USER=healthguard
POSTGRES_PASSWORD=healthguard_dev_only
MINIO_ROOT_USER=healthguard
MINIO_ROOT_PASSWORD=replace-with-development-secret
PROMETHEUS_MULTIPROC_DIR=/var/run/healthguard/metrics
HEALTHGUARD_WORKER_HEARTBEAT_SECONDS=15

# --- Admin / operations console (P0) ---
# The /admin console is invisible (404) until this is set. >= 32 random chars. Used to derive per-admin TOTP secrets; never stored in the DB.
HEALTHGUARD_ADMIN_TOTP_KEY=
# Optional alert thresholds
# HEALTHGUARD_ALERT_QUEUE_DEPTH=100
# HEALTHGUARD_ALERT_AUTH_FAILURES_15M=20
# HEALTHGUARD_SECURITY_EVENT_RETENTION_DAYS=30
# Shown on the Deployment page
# APP_VERSION=
# GIT_SHA=

# --- Email reminders for confirmed/scheduled follow-ups (email only; dispatched by the existing worker) ---
# Requires SMTP_HOST / SMTP_FROM (same settings as account verification) and HEALTHGUARD_PUBLIC_BASE_URL for links.
# HEALTHGUARD_REMINDERS_ENABLED=true
# HEALTHGUARD_REMINDER_TICK_SECONDS=30
# HEALTHGUARD_REMINDER_RECONCILE_SECONDS=60
# HEALTHGUARD_REMINDER_MAX_ATTEMPTS=5
# HEALTHGUARD_REMINDER_BACKOFF_SECONDS=60
# HEALTHGUARD_REMINDER_MAX_LATENESS_HOURS=12
# HEALTHGUARD_REMINDER_LEASE_SECONDS=120
# SMTP_TIMEOUT_SECONDS=15
